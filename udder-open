#!/bin/bash

set -euo pipefail

proc_root="${UDDER_PROC_ROOT:-/proc}"
hyprctl_bin="${UDDER_HYPRCTL_BIN:-hyprctl}"
jq_bin="${UDDER_JQ_BIN:-jq}"
pgrep_bin="${UDDER_PGREP_BIN:-pgrep}"
omarchy_bin="${UDDER_OMARCHY_BIN:-omarchy}"
dry_run=false
remote_pid=""

while (($# > 0)); do
  case "$1" in
  --dry-run)
    dry_run=true
    ;;
  --remote)
    remote_pid="${2:-}"
    shift
    ;;
  *)
    printf 'Usage: udder-open [--dry-run] [--remote PID]\n' >&2
    exit 2
    ;;
  esac
  shift
done

read_ppid() {
  local pid="$1" key value rest
  [[ -r $proc_root/$pid/status ]] || return 1
  while read -r key value rest; do
    if [[ $key == PPid: ]]; then
      printf '%s\n' "$value"
      return 0
    fi
  done <"$proc_root/$pid/status"
  return 1
}

is_default_local_client() {
  local pid="$1"
  local -a argv=()
  [[ -r $proc_root/$pid/cmdline ]] || return 1
  mapfile -d '' -t argv <"$proc_root/$pid/cmdline"
  ((${#argv[@]} == 1)) || return 1
  [[ ${argv[0]##*/} == herdr ]]
}

is_remote_client() {
  local pid="$1" arg
  local -a argv=()
  [[ $pid =~ ^[0-9]+$ && -r $proc_root/$pid/cmdline && -O $proc_root/$pid/cmdline ]] || return 1
  mapfile -d '' -t argv <"$proc_root/$pid/cmdline"
  ((${#argv[@]} >= 3)) || return 1
  [[ ${argv[0]##*/} == herdr ]] || return 1
  for arg in "${argv[@]:1}"; do
    [[ $arg == --remote || $arg == --remote=* ]] && return 0
  done
  return 1
}

window_owns_process() {
  local window_pid="$1" process_pid="$2" current="$2" parent depth
  for ((depth = 0; depth < 64; depth++)); do
    [[ $current == "$window_pid" ]] && return 0
    [[ $current =~ ^[0-9]+$ && $current -gt 1 ]] || return 1
    parent=$(read_ppid "$current") || return 1
    [[ $parent != "$current" ]] || return 1
    current="$parent"
  done
  return 1
}

declare -a local_clients=()
if [[ -n $remote_pid ]]; then
  is_remote_client "$remote_pid" || exit 1
  local_clients+=("$remote_pid")
else
  while read -r pid; do
    [[ $pid =~ ^[0-9]+$ ]] || continue
    if is_default_local_client "$pid"; then
      local_clients+=("$pid")
    fi
  done < <("$pgrep_bin" -x herdr 2>/dev/null || true)
fi

if ((${#local_clients[@]} > 0)); then
  clients_json=$($hyprctl_bin clients -j 2>/dev/null || printf '[]')
  while IFS=$'\t' read -r address workspace window_pid; do
    [[ $address =~ ^0x[0-9a-fA-F]+$ && -n $workspace && $window_pid =~ ^[0-9]+$ ]] || continue
    for client_pid in "${local_clients[@]}"; do
      if window_owns_process "$window_pid" "$client_pid"; then
        if $dry_run; then
          printf 'focus\t%s\t%s\t%s\t%s\n' "$address" "$workspace" "$window_pid" "$client_pid"
          exit 0
        fi
        if "$hyprctl_bin" dispatch \
          "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1; then
          exit 0
        fi
        # Hyprland before 0.56 used the legacy text dispatcher syntax.
        "$hyprctl_bin" dispatch focuswindow "address:$address" >/dev/null
        exit 0
      fi
    done
  done < <(
    "$jq_bin" -r '
      sort_by(.focusHistoryID // 2147483647)
      | .[]
      | select(.mapped == true)
      | [
          (.address // ""),
          (.workspace.name // (.workspace.id | tostring) // ""),
          (.pid | tostring)
        ]
      | @tsv
    ' <<<"$clients_json" 2>/dev/null || true
  )

  if $dry_run; then
    if [[ -n $remote_pid ]]; then
      printf 'unmapped-remote-client\t%s\n' "${local_clients[0]}"
    else
      printf 'unmapped-local-client\t%s\n' "${local_clients[0]}"
    fi
  fi
  exit 1
fi

[[ -z $remote_pid ]] || exit 1

if $dry_run; then
  printf 'launch\n'
  exit 0
fi

exec "$omarchy_bin" launch terminal herdr
