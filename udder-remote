#!/bin/bash

set -euo pipefail

proc_root="${UDDER_PROC_ROOT:-/proc}"
tmp_root="${UDDER_TMP_ROOT:-${TMPDIR:-/tmp}}"
ssh_bin="${UDDER_SSH_BIN:-ssh}"
timeout_bin="${UDDER_TIMEOUT_BIN:-timeout}"
jq_bin="${UDDER_JQ_BIN:-jq}"
sha256sum_bin="${UDDER_SHA256SUM_BIN:-sha256sum}"
runtime_root="${UDDER_RUNTIME_ROOT:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/udder}"

remote_target=""
remote_session="default"
remote_config=""
remote_control=""
ssh_destination=""
ssh_port=""

control_is_usable() {
  local path="$1"
  [[ -S $path || (${UDDER_TEST_ALLOW_CONTROL_FILE:-0} == 1 && -f $path) ]]
}

read_remote_process() {
  local pid="$1" arg index
  local -a argv=()
  [[ $pid =~ ^[0-9]+$ && -r $proc_root/$pid/cmdline && -O $proc_root/$pid/cmdline ]] || return 1
  mapfile -d '' -t argv <"$proc_root/$pid/cmdline"
  ((${#argv[@]} >= 3)) || return 1
  [[ ${argv[0]##*/} == herdr ]] || return 1

  remote_target=""
  remote_session="default"
  for ((index = 1; index < ${#argv[@]}; index++)); do
    arg="${argv[index]}"
    if [[ $arg == --remote && $((index + 1)) -lt ${#argv[@]} ]]; then
      remote_target="${argv[index + 1]}"
      ((index += 1))
    elif [[ $arg == --remote=* ]]; then
      remote_target="${arg#--remote=}"
    elif [[ $arg == --session && $((index + 1)) -lt ${#argv[@]} ]]; then
      remote_session="${argv[index + 1]}"
      ((index += 1))
    elif [[ $arg == --session=* ]]; then
      remote_session="${arg#--session=}"
    fi
  done

  [[ -n $remote_target && $remote_target != -* && -n $remote_session ]] || return 1
}

find_remote_control() {
  local pid="$1" directory
  remote_config=""
  remote_control=""
  for directory in "$tmp_root"/herdr-ssh-"$pid"-*; do
    [[ -d $directory && -O $directory && -r $directory/config && -O $directory/config ]] || continue
    control_is_usable "$directory/ctl" || continue
    [[ -O $directory/ctl ]] || continue
    remote_config="$directory/config"
    remote_control="$directory/ctl"
    return 0
  done
  return 1
}

remote_id() {
  "$jq_bin" -cnr --arg target "$remote_target" --arg session "$remote_session" \
    '[$target, $session] | @json | @base64'
}

validate_remote() {
  [[ -n $remote_target && $remote_target != -* && -n $remote_session ]]
}

prepare_ssh_target() {
  local authority user_part="" host_part
  ssh_destination="$remote_target"
  ssh_port=""
  [[ $remote_target == ssh://* ]] || return 0

  authority="${remote_target#ssh://}"
  [[ -n $authority && $authority != */* && $authority != *\?* && $authority != *\#* ]] || return 1
  if [[ $authority == *@* ]]; then
    user_part="${authority%@*}"
    authority="${authority##*@}"
    [[ -n $user_part ]] || return 1
  fi

  if [[ $authority =~ ^\[([^]]+)\](:([0-9]+))?$ ]]; then
    host_part="[${BASH_REMATCH[1]}]"
    ssh_port="${BASH_REMATCH[3]:-}"
  elif [[ $authority =~ ^(.+):([0-9]+)$ ]]; then
    host_part="${BASH_REMATCH[1]}"
    ssh_port="${BASH_REMATCH[2]}"
  else
    host_part="$authority"
  fi
  [[ -n $host_part && ( -z $ssh_port || ( $ssh_port -ge 1 && $ssh_port -le 65535 ) ) ]] || return 1
  ssh_destination="${user_part:+$user_part@}$host_part"
}

remote_command() {
  if [[ $remote_session == default ]]; then
    printf '%s\n' 'herdr api snapshot'
  else
    printf 'herdr --session %q api snapshot\n' "$remote_session"
  fi
}

owned_control_path() {
  local digest
  digest=$(printf '%s\0%s' "$remote_target" "$remote_session" | "$sha256sum_bin")
  digest="${digest%% *}"
  printf '%s/ssh-%s\n' "$runtime_root" "${digest:0:32}"
}

ensure_runtime_root() {
  mkdir -p -- "$runtime_root"
  chmod 700 -- "$runtime_root"
}

discover() {
  local proc_dir pid id label record separator=""
  printf '['
  for proc_dir in "$proc_root"/[0-9]*; do
    [[ -d $proc_dir ]] || continue
    pid="${proc_dir##*/}"
    read_remote_process "$pid" || continue
    find_remote_control "$pid" || continue
    id=$(remote_id)
    label="$remote_target"
    [[ $remote_session == default ]] || label+=" / $remote_session"
    record=$("$jq_bin" -cn \
      --arg id "$id" \
      --arg target "$remote_target" \
      --arg session "$remote_session" \
      --arg label "$label" \
      --argjson pid "$pid" \
      '{id: $id, target: $target, session: $session, label: $label, pid: $pid}')
    printf '%s%s' "$separator" "$record"
    separator=,
  done
  printf ']\n'
}

snapshot_from_process() {
  local pid="${1:-}" remote_command
  read_remote_process "$pid" || {
    printf 'Remote Herdr process is no longer running.\n' >&2
    return 1
  }
  find_remote_control "$pid" || {
    printf 'Remote Herdr SSH connection is unavailable.\n' >&2
    return 1
  }

  if [[ $remote_session == default ]]; then
    remote_command="herdr api snapshot"
  else
    printf -v remote_command 'herdr --session %q api snapshot' "$remote_session"
  fi

  "$timeout_bin" --kill-after=1s 6s \
    "$ssh_bin" -F "$remote_config" -S "$remote_control" \
    -o BatchMode=yes -o ConnectTimeout=2 -T "$remote_target" "$remote_command"
}

snapshot_remote() {
  local control remote_command_value
  remote_target="${1:-}"
  remote_session="${2:-default}"
  validate_remote || {
    printf 'Invalid remote Herdr target or session.\n' >&2
    return 2
  }
  prepare_ssh_target || {
    printf 'Invalid remote Herdr SSH URL.\n' >&2
    return 2
  }

  ensure_runtime_root
  control=$(owned_control_path)
  remote_command_value=$(remote_command)
  local -a port_args=()
  [[ -z $ssh_port ]] || port_args=(-p "$ssh_port")
  "$timeout_bin" --kill-after=1s 8s \
    "$ssh_bin" "${port_args[@]}" \
    -o BatchMode=yes -o ConnectTimeout=3 -o ConnectionAttempts=1 \
    -o ControlMaster=auto -o ControlPersist=90 \
    -o ControlPath="$control" -T "$ssh_destination" "$remote_command_value"
}

stop_remote() {
  local control
  local -a port_args=()
  remote_target="${1:-}"
  remote_session="${2:-default}"
  validate_remote || return 2
  prepare_ssh_target || return 2
  [[ -z $ssh_port ]] || port_args=(-p "$ssh_port")
  control=$(owned_control_path)
  [[ -e $control || -S $control ]] || return 0
  "$timeout_bin" --kill-after=1s 4s \
    "$ssh_bin" "${port_args[@]}" -o BatchMode=yes -o ControlPath="$control" \
    -O exit "$ssh_destination" >/dev/null 2>&1 || true
  [[ ! -e $control && ! -S $control ]] || rm -f -- "$control"
}

case "${1:-}" in
discover)
  discover
  ;;
snapshot)
  if [[ ${2:-} =~ ^[0-9]+$ && $# -eq 2 ]]; then
    snapshot_from_process "$2"
  else
    snapshot_remote "${2:-}" "${3:-default}"
  fi
  ;;
stop)
  stop_remote "${2:-}" "${3:-default}"
  ;;
*)
  printf 'Usage: udder-remote <discover|snapshot TARGET [SESSION]|stop TARGET [SESSION]>\n' >&2
  exit 2
  ;;
esac
